# Copy to .env and fill in when a lesson needs a real model.
# .env is gitignored - never commit real credentials.

# OpenRouter (used by src/gh600/llm.py:OpenRouterLLM and examples/run_agent.py)
# Get a key at https://openrouter.ai/keys - the default model below is free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# GitHub Models
GITHUB_TOKEN=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# OpenAI
OPENAI_API_KEY=
